{
  "name": "monarch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "packages:publish": "vp run build && changeset publish",
    "packages:version": "changeset version && vp install --lockfile-only --ignore-scripts --no-frozen-lockfile && vp run check && vp run test",
    "prepare": "vp config --no-agent",
    "solidity:build": "vp run --filter './solidity/*' build",
    "solidity:fmt": "vp run --filter './solidity/*' fmt",
    "solidity:lint": "vp run --filter './solidity/*' lint",
    "solidity:testing": "vp run --filter './solidity/*' test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@cloudflare/workers-types": "catalog:types",
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:types",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.21.0",
  "pnpm": {
    "overrides": {
      "es-define-property": "npm:@socketregistry/es-define-property@^1",
      "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@^1",
      "function-bind": "npm:@socketregistry/function-bind@^1",
      "gopd": "npm:@socketregistry/gopd@^1",
      "has-symbols": "npm:@socketregistry/has-symbols@^1",
      "has-tostringtag": "npm:@socketregistry/has-tostringtag@^1",
      "hasown": "npm:@socketregistry/hasown@^1",
      "shell-quote": "npm:shell-quote@^1",
      "yocto-spinner": "npm:@socketregistry/yocto-spinner@^1"
    }
  }
}
