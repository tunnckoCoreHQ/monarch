{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "patches/**"
  ],
  "agentGuidance": false,
  "concurrency": "4",
  "tasks": {
    "//#check": {
      "inputs": [
        "*.md",
        "*.json",
        "*.ts",
        ".changeset/**",
        "scripts/**",
        ".depot/**",
        ".github/**",
        ".rwx/**",
        ".zed/**"
      ],
      "outputs": []
    },
    "check": {
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.{yml,yaml}"],
      "outputs": [".vitest-results.json", "coverage/**"]
    },
    "fmt": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["fmt"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".cloudflare/output/**"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**"],
      "env": ["COMMIT_SHA"]
    },
    "deploy:nightly": {
      "cache": false,
      "passThroughEnv": ["COMMIT_SHA", "CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    },
    "deploy:prod": {
      "cache": false,
      "passThroughEnv": ["COMMIT_SHA", "CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    }
  }
}
