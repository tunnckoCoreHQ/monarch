{
  "compilerOptions": {
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "DOM"],
    "types": ["@cloudflare/workers-types", "vite-plus/test/globals", "node", "bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/*/.astro/types.d.ts",
    "packages/**/*.ts",
    "solidity/**/*.ts",
    "**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
