---
import "../styles.css";

const routes = [
    ["Ethereum Mainnet", "PrimeV", "1.2s settlement, sponsored gas"],
    ["Base + CDP EVM", "CDP", "seller-generated CDP JWT"],
    ["Solana + CDP SVM", "CDP", "same pass-through auth"],
    ["Public test/dev networks", "x402.org", "public coverage"],
];

const pageTitle = "WGW x402 Router";
const pageDescription =
    "Use one standard x402 facilitator endpoint and route payments to PrimeV, x402.org, or CDP without storing seller secrets on the hosted router.";
const routerOrigin = Astro.url.origin;
const sourceUrl = `https://github.com/tunnckoCore/wgw-deploy-cf/tree/codex/cdn-hosted-manifests/packages/x402-router`;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="canonical" href={Astro.url} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
    </head>
    <body class="bg-page text-primary antialiased">
        <main>
            <section
                class="relative isolate overflow-hidden border-b border-line"
            >
                <div class="hero-grid absolute inset-0 -z-10"></div>
                <div
                    class="hero-shell mx-auto flex max-w-7xl flex-col justify-between gap-8 px-5 py-8 md:px-8 lg:px-10"
                >
                    <nav
                        class="flex items-center justify-between text-sm text-secondary"
                    >
                        <a href="/" class="font-semibold"
                            ><span class="text-accent">x402-router</span
                            >.wgw.lol</a
                        >
                        <div class="flex items-center gap-5">
                            <a
                                class="text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                                href="/docs/integration/">Integration</a
                            >
                            <a
                                class="text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                                href="/docs/self-hosting/">Self-host</a
                            >
                            <a
                                class="inline-flex items-center gap-1.5 text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                                href={sourceUrl}
                                rel="noreferrer external"
                                target="_blank"
                                >GitHub
                                <svg
                                    class="h-3.5 w-3.5"
                                    aria-hidden="true"
                                    viewBox="0 0 16 16"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M8 0C3.58 0 0 3.67 0 8.2c0 3.62 2.29 6.69 5.47 7.77.4.08.55-.18.55-.39 0-.19-.01-.84-.01-1.52-2.01.38-2.53-.5-2.69-.96-.09-.24-.48-.96-.82-1.15-.28-.15-.68-.52-.01-.53.63-.01 1.08.59 1.23.84.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.09-1.78-.21-3.64-.91-3.64-4.03 0-.89.31-1.62.82-2.19-.08-.21-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.4 7.4 0 0 1 8 4.04c.68 0 1.36.09 2 .28 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.95.08 2.16.51.57.82 1.3.82 2.19 0 3.13-1.87 3.82-3.65 4.03.29.26.54.75.54 1.52 0 1.09-.01 1.97-.01 2.24 0 .21.15.47.55.39A8.06 8.06 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z"
                                    ></path>
                                </svg></a
                            >
                        </div>
                    </nav>

                    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
                        <div class="flex flex-col justify-center">
                            <div class="max-w-2xl">
                                <h1
                                    class="text-4xl font-semibold leading-none text-primary md:text-5xl lg:text-6xl"
                                >
                                    One x402 facilitator URL. Routed to the
                                    right provider.
                                </h1>
                                <p
                                    class="mt-6 max-w-2xl text-lg leading-8 text-muted"
                                >
                                    For sellers adding x402 payments, point your
                                    standard facilitator client at WGW. The
                                    router receives normal x402 requests, reads
                                    the network and version, then sends the work
                                    to PrimeV, x402.org, or CDP.
                                </p>
                                <p
                                    class="mt-4 max-w-2xl text-base leading-7 text-secondary"
                                >
                                    CDP credentials stay on your server. When a
                                    request needs CDP, your app adds a
                                    short-lived forwarded header. The hosted
                                    router stores no seller secrets.
                                </p>
                                <div class="mt-8 flex flex-wrap gap-3">
                                    <a
                                        href="/docs/getting-started/"
                                        class="inline-flex h-11 items-center justify-center rounded-md border border-accent bg-panel px-5 text-sm font-semibold text-accent hover:bg-accent hover:text-page"
                                    >
                                        Use the hosted endpoint
                                    </a>
                                </div>
                                <div
                                    class="mt-6 max-w-xl border border-line bg-code px-4 py-3 font-mono text-sm text-code-text"
                                >
                                    {routerOrigin}
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div
                                class="w-full overflow-hidden rounded-lg border border-line bg-frame"
                            >
                                <div
                                    class="flex items-center justify-between border-b border-line bg-panel px-3 py-2 text-xs text-secondary"
                                >
                                    <span>hosted WGW router</span>
                                    <span
                                        id="router-health"
                                        class="text-secondary"
                                    >
                                        <span id="router-health-label"
                                            >checking</span
                                        >
                                    </span>
                                </div>
                                <div class="p-3">
                                    <pre
                                        class="overflow-x-auto whitespace-pre-wrap break-words rounded-md border border-line bg-code p-3 font-mono text-[11px] leading-5 text-code-text md:whitespace-pre md:text-xs"><code><span class="text-info">import</span> &#123; <span class="text-primary">createCdpAuthHeaders</span> &#125; <span class="text-info">from</span> <span class="text-warn">"@tunnckocore/x402-router/cdp"</span>;

<span class="text-info">const</span> <span class="text-primary">facilitator</span> = <span class="text-info">new</span> <span class="text-accent">HTTPFacilitatorClient</span>(&#123;
  <span class="text-secondary">url</span>: <span class="text-warn">"{routerOrigin}"</span>,
  <span class="text-secondary">createAuthHeaders</span>: () =&gt;
    <span class="text-accent">createCdpAuthHeaders</span>(&#123;
      <span class="text-secondary">apiKeyId</span>: <span class="text-primary">process</span>.<span class="text-secondary">env</span>.<span class="text-primary">CDP_API_KEY_ID</span>,
      <span class="text-secondary">apiKeySecret</span>: <span class="text-primary">process</span>.<span class="text-secondary">env</span>.<span class="text-primary">CDP_API_KEY_SECRET</span>,
    &#125;),
&#125;);</code></pre>
                                    <div
                                        class="mt-3 divide-y divide-line border-y border-line"
                                    >
                                        {
                                            routes.map(
                                                ([
                                                    network,
                                                    upstream,
                                                    detail,
                                                ]) => (
                                                    <div class="grid gap-2 py-3 text-sm sm:grid-cols-[1fr_5rem_1.2fr] sm:items-center">
                                                        <div class="font-medium text-primary">
                                                            {network}
                                                        </div>
                                                        <div class="text-info">
                                                            {upstream}
                                                        </div>
                                                        <div class="text-secondary">
                                                            {detail}
                                                        </div>
                                                    </div>
                                                ),
                                            )
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-sm">
                        <div
                            class="flex flex-wrap items-center justify-between gap-3"
                        >
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="text-secondary"
                                    >/supported, /verify, /settle</span
                                >
                                <span class="text-edge">-></span>
                                <span class="text-accent">WGW router</span>
                                <span class="text-edge">-></span>
                                <span class="text-primary">PrimeV</span>
                                <span class="text-edge">/</span>
                                <span class="text-primary">x402.org</span>
                                <span class="text-edge">/</span>
                                <span class="text-primary">CDP</span>
                            </div>
                            <span class="text-secondary">
                                x402 v2, CDP header forwarded only when needed
                            </span>
                        </div>
                    </div>
                </div>
            </section>

            <section
                class="border-b border-line bg-band px-5 py-16 md:px-8 lg:px-10"
            >
                <div class="mx-auto max-w-7xl lg:px-10">
                    <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr]">
                        <div>
                            <p class="text-sm font-semibold text-accent">
                                What changes
                            </p>
                            <h2
                                class="mt-3 text-3xl font-semibold text-primary md:text-4xl"
                            >
                                Change the facilitator URL, not the payment
                                flow.
                            </h2>
                        </div>
                        <div class="divide-y divide-line border-y border-line">
                            <div
                                class="grid gap-3 py-5 md:grid-cols-[11rem_1fr]"
                            >
                                <h3 class="font-semibold text-primary">
                                    Standard x402 surface
                                </h3>
                                <p class="leading-7 text-secondary">
                                    Your middleware still calls
                                    <code>/supported</code>, <code>/verify</code
                                    >, and <code>/settle</code>. WGW behaves
                                    like the facilitator endpoint your x402
                                    stack already expects.
                                </p>
                            </div>
                            <div
                                class="grid gap-3 py-5 md:grid-cols-[11rem_1fr]"
                            >
                                <h3 class="font-semibold text-primary">
                                    Explicit upstream choice
                                </h3>
                                <p class="leading-7 text-secondary">
                                    Ethereum Mainnet goes to PrimeV.
                                    CDP-supported EVM and SVM networks go to CDP.
                                    Public test and dev networks come from
                                    x402.org.
                                </p>
                            </div>
                            <div
                                class="grid gap-3 py-5 md:grid-cols-[11rem_1fr]"
                            >
                                <h3 class="font-semibold text-primary">
                                    Seller-owned CDP auth
                                </h3>
                                <p class="leading-7 text-secondary">
                                    CDP credentials stay on your server and
                                    create a short-lived JWT. The hosted router
                                    forwards that header to CDP when needed and
                                    keeps no seller-side key storage.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="bg-page px-5 py-14 md:px-8 lg:px-10">
                <div class="mx-auto max-w-7xl lg:px-10">
                    <div
                        class="grid gap-6 border-y border-line py-8 md:grid-cols-[1fr_auto] md:items-center"
                    >
                        <div>
                            <h2
                                class="text-2xl font-semibold text-primary"
                            >
                                Start hosted. Self-host when policy needs it.
                            </h2>
                            <p class="mt-2 max-w-2xl text-secondary">
                                Use the WGW endpoint first and keep the
                                integration small. If you need private
                                infrastructure or custom upstream policy, run the
                                same Worker from the <a
                                    class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-high"
                                    href="/docs/self-hosting/"
                                    >self-hosting notes</a
                                >.
                            </p>
                        </div>
                        <a
                            href="/docs/getting-started/"
                            class="inline-flex h-11 shrink-0 items-center justify-center rounded-md border border-accent bg-panel px-5 text-sm font-semibold text-accent hover:bg-accent hover:text-page"
                        >
                            Use the hosted endpoint
                        </a>
                    </div>
                </div>
            </section>
        </main>
        <footer class="border-t border-line bg-band px-5 py-8 md:px-8 lg:px-10">
            <div class="mx-auto max-w-7xl lg:px-10">
                <div
                    class="flex flex-col gap-4 text-sm text-secondary md:flex-row md:items-center md:justify-between"
                >
                    <div>
                        License <a
                            class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:text-accent-high"
                            href="https://fsf.software"
                            rel="noreferrer external"
                            target="_blank">FSL-1.1-ALv2</a
                        >
                    </div>
                    <nav class="flex flex-wrap gap-x-5 gap-y-2">
                        <a
                            class="text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                            href="/docs/integration/">Integration</a
                        >
                        <a
                            class="text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                            href="/docs/self-hosting/">Self-host</a
                        >
                        <a
                            class="inline-flex items-center gap-1.5 text-secondary hover:text-accent hover:underline hover:underline-offset-4"
                            href={sourceUrl}
                            rel="noreferrer external"
                            target="_blank"
                            >GitHub
                            <svg
                                class="h-3.5 w-3.5"
                                aria-hidden="true"
                                viewBox="0 0 16 16"
                                fill="currentColor"
                            >
                                <path
                                    d="M8 0C3.58 0 0 3.67 0 8.2c0 3.62 2.29 6.69 5.47 7.77.4.08.55-.18.55-.39 0-.19-.01-.84-.01-1.52-2.01.38-2.53-.5-2.69-.96-.09-.24-.48-.96-.82-1.15-.28-.15-.68-.52-.01-.53.63-.01 1.08.59 1.23.84.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.09-1.78-.21-3.64-.91-3.64-4.03 0-.89.31-1.62.82-2.19-.08-.21-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.4 7.4 0 0 1 8 4.04c.68 0 1.36.09 2 .28 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.95.08 2.16.51.57.82 1.3.82 2.19 0 3.13-1.87 3.82-3.65 4.03.29.26.54.75.54 1.52 0 1.09-.01 1.97-.01 2.24 0 .21.15.47.55.39A8.06 8.06 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z"
                                ></path>
                            </svg></a
                        >
                    </nav>
                </div>
            </div>
        </footer>
        <script is:inline>
            const health = document.querySelector("#router-health");
            const label = document.querySelector("#router-health-label");

            fetch("/health", {
                headers: { accept: "application/json" },
            })
                .then((response) =>
                    response.ok ? response.json() : Promise.reject(),
                )
                .then((body) => {
                    const ok = body && body.ok === true;

                    health?.classList.remove(
                        "text-secondary",
                        "text-accent",
                        "text-danger",
                    );

                    health?.classList.add(ok ? "text-accent" : "text-danger");
                    if (label) {
                        label.textContent = ok ? "online" : "offline";
                    }
                })
                .catch(() => {
                    health?.classList.remove("text-secondary", "text-accent");
                    health?.classList.add("text-danger");
                    if (label) {
                        label.textContent = "offline";
                    }
                });
        </script>
    </body>
</html>
