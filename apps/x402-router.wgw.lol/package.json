{
  "name": "x402-router.wgw.lol",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "vp exec astro",
    "build": "vp run --no-cache generate-public && vp exec cf build && vp run build:cf",
    "build:cf": "vp exec cf deploy --dry-run --prebuilt --mode production",
    "check": "vp check --fix",
    "deploy": "vp exec cf deploy --prebuilt --mode production",
    "dev": "WGW_ASTRO_NO_ADAPTER=1 vp exec astro dev",
    "dev:cf": "vp run --no-cache generate-public && vp exec cf dev",
    "generate-public": "node scripts/generate-public.mjs",
    "generate-types": "vp exec cf workers types",
    "preview": "vp exec astro preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@astrojs/starlight": "0.42.2",
    "@tailwindcss/vite": "4.3.3",
    "@tunnckocore/x402-router": "workspace:^",
    "astro": "catalog:",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "cf": "catalog:",
    "typescript": "catalog:types"
  }
}
