{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "triad-auth-nightly",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "triad-auth-nightly.wgw.lol/*", "zone_name": "wgw.lol" }],
  "vars": {
    "AUTH_ORIGIN": "https://triad-auth-nightly.wgw.lol",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triad-auth-nightly",
      "database_id": "c4c8e874-a463-4c22-8389-8911627c055d",
      "migrations_dir": "migrations",
    },
  ],
}
