---
import Shell from "../components/Shell.astro";

export const prerender = true;
---

<Shell title="Your identity | Triad" mode="product">
  <section class="account shell" aria-labelledby="account-title">
    <div class="account-heading">
      <p>YOUR AUTHORIZATION SESSION</p>
      <h1 id="account-title">YOUR<br /><span>IDENTITY.</span></h1>
      <p id="account-summary" class="lede" aria-live="polite">Loading your session...</p>
    </div>

    <div id="signed-out" class="signed-out" hidden>
      <p>
        Choose one credential. Triad derives a separate account from that provider, wallet, or passkey and
        never links credentials together.
      </p>
      <div class="control-feedback">
        <div id="account-provider-actions" class="actions" aria-live="polite"></div>
      </div>
    </div>

    <div id="account-content" hidden>
      <section class="account-panel" aria-labelledby="ids-title">
        <h2 id="ids-title">IDENTIFIERS</h2>
        <dl class="account-ids">
          <div><dt>ACCOUNT SUB</dt><dd id="account-sub">PENDING</dd></div>
          <div><dt>LINKED IDENTITIES</dt><dd id="identity-list">PENDING</dd></div>
        </dl>
      </section>

      <section id="account-passkey-panel" class="account-panel" aria-labelledby="wallet-passkeys-title">
        <div class="panel-heading">
          <h2 id="wallet-passkeys-title">PASSKEYS</h2>
          <span id="passkey-count">0</span>
        </div>
        <p id="account-passkey-copy" class="account-panel-copy">Loading passkey roles...</p>
        <div id="account-passkeys" class="account-passkeys"></div>
        <form id="attach-passkey-form" class="passkey-registration account-passkey-registration">
          <label for="attached-passkey-name">PASSKEY NAME</label>
          <input
            id="attached-passkey-name"
            name="attached-passkey-name"
            type="text"
            autocomplete="off"
            minlength="1"
            maxlength="64"
            placeholder="Phone, security key, laptop"
            required
          />
          <button id="attach-passkey" class="button secondary" type="submit">ATTACH PASSKEY</button>
        </form>
      </section>

      <section class="account-panel" aria-labelledby="apps-title">
        <div class="panel-heading"><h2 id="apps-title">AUTHORIZED APPS</h2><span id="app-count">0</span></div>
        <p class="fine-print">
          Removing consent deletes the stored approval. Existing tokens may remain valid until expiry. Sign out
          separately to end this browser session.
        </p>
        <div id="authorized-apps" class="authorized-apps"></div>
      </section>
      <div class="actions account-actions">
        <button id="logout" class="button danger" type="button">SIGN OUT</button>
      </div>

      <section class="account-panel account-danger" aria-labelledby="delete-account-title">
        <div class="panel-heading">
          <h2 id="delete-account-title">DELETE ACCOUNT</h2>
        </div>
        <div class="account-danger-copy">
          <p>Delete the Triad account, its profile envelope, sessions, consents, grants, and device records.</p>
          <p class="fine-print">Already issued short-lived tokens may remain valid until expiry. This action cannot be undone.</p>
          <button id="delete-account" class="button danger" type="button">DELETE ACCOUNT</button>
        </div>
      </section>
    </div>

    <div class="control-feedback">
      <p id="me-error" class="error-message" role="alert" tabindex="-1" hidden></p>
      <button id="account-retry" class="button secondary" type="button" hidden>RETRY ACCOUNT</button>
    </div>
  </section>

  <script>
    import {
      startAuthentication,
      startRegistration,
      type AuthenticationResponseJSON,
      type PublicKeyCredentialCreationOptionsJSON,
      type PublicKeyCredentialRequestOptionsJSON,
    } from "@simplewebauthn/browser";
    import { inspectOAuthQuery } from "../scripts/demo-protocol";
    import { passkeyPrfResult, signWithPrfWallet, walletPrfExtension } from "../scripts/prf-wallet";
    import { isRecord, isoDate, jsonResponse, responseError } from "../utils";
    import {
      accountSubjectWebAuthnUserId,
      passkeyWebAuthnUserId,
    } from "../better-auth/identity/passkey-username";
    import { SOCIAL_PROVIDERS } from "../better-auth/identity/subjects";

    type LinkedAccount = { providerId?: string };
    type OAuthConsent = {
      clientId?: string;
      id?: string;
      resources?: string[];
      scopes?: string[];
      updatedAt?: string;
    };
    type PublicClient = { client_id?: string; client_name?: string };
    type SessionResult = { user?: { id?: string; provider?: string } } | null;
    type AccountPasskey = {
      id: string;
      name: string | null;
      backedUp: boolean;
      createdAt: string | number | null;
      role: "identity" | "attached";
      walletCapable: boolean;
      removable: boolean;
    };

    interface WalletCapabilityOptions {
      request_id: string;
      options: PublicKeyCredentialRequestOptionsJSON;
      prf_salt: string;
      signing_message: string;
      wallet_profile: import("../better-auth/wallet").WalletProfileId;
      account_index: number;
      expires_at: string;
    }

    interface EthereumProvider {
      request(input: { method: string; params?: unknown[] }): Promise<unknown>;
    }

    const providers = SOCIAL_PROVIDERS;

    function decodeNothing(_value: unknown): undefined {
      return undefined;
    }

    function decodeOptionalString(value: unknown, property: string, message: string): Record<string, string | undefined> {
      if (!isRecord(value) || (value[property] !== undefined && typeof value[property] !== "string")) {
        throw new Error(message);
      }

      return { [property]: typeof value[property] === "string" ? value[property] : undefined };
    }

    function decodeAuthenticationOptions(value: unknown): PublicKeyCredentialRequestOptionsJSON {
      if (!isRecord(value) || typeof value.challenge !== "string") {
        throw new Error("Triad returned invalid passkey authentication options.");
      }

      return value as unknown as PublicKeyCredentialRequestOptionsJSON;
    }

    function decodeRegistrationOptions(value: unknown): PublicKeyCredentialCreationOptionsJSON {
      if (!isRecord(value) || typeof value.challenge !== "string" || !isRecord(value.user) || !Array.isArray(value.pubKeyCredParams)) {
        throw new Error("Triad returned invalid passkey registration options.");
      }

      return value as unknown as PublicKeyCredentialCreationOptionsJSON;
    }

    function decodeAccountPasskeys(value: unknown): AccountPasskey[] {
      if (!Array.isArray(value)) {
        throw new Error("Triad returned an invalid Passkey list.");
      }

      return value.map((passkey) => {
        if (
          !isRecord(passkey) ||
          typeof passkey.id !== "string" ||
          (passkey.name !== null && typeof passkey.name !== "string") ||
          typeof passkey.backedUp !== "boolean" ||
          (passkey.role !== "identity" && passkey.role !== "attached") ||
          typeof passkey.walletCapable !== "boolean" ||
          typeof passkey.removable !== "boolean"
        ) {
          throw new Error("Triad returned an invalid Passkey.");
        }

        return {
          id: passkey.id,
          name: passkey.name,
          backedUp: passkey.backedUp,
          createdAt:
            typeof passkey.createdAt === "number" || typeof passkey.createdAt === "string"
              ? passkey.createdAt
              : null,
          role: passkey.role,
          walletCapable: passkey.walletCapable,
          removable: passkey.removable,
        };
      });
    }

    function decodeWalletCapabilityOptions(value: unknown): WalletCapabilityOptions {
      if (
        !isRecord(value) ||
        typeof value.request_id !== "string" ||
        !isRecord(value.options) ||
        typeof value.options.challenge !== "string" ||
        typeof value.prf_salt !== "string" ||
        typeof value.signing_message !== "string" ||
        value.wallet_profile !== "evm" ||
        value.account_index !== 0 ||
        typeof value.expires_at !== "string"
      ) {
        throw new Error("Triad returned invalid Wallet Capability options.");
      }

      return {
        request_id: value.request_id,
        options: value.options as unknown as PublicKeyCredentialRequestOptionsJSON,
        prf_salt: value.prf_salt,
        signing_message: value.signing_message,
        wallet_profile: value.wallet_profile,
        account_index: value.account_index,
        expires_at: value.expires_at,
      };
    }

    function decodePublicClient(value: unknown): PublicClient {
      if (!isRecord(value)) {
        throw new Error("Triad returned invalid client metadata.");
      }

      return {
        ...(typeof value.client_id === "string" ? { client_id: value.client_id } : {}),
        ...(typeof value.client_name === "string" ? { client_name: value.client_name } : {}),
      };
    }

    function decodeSession(value: unknown): SessionResult {
      if (value === null) {
        return null;
      }
      if (!isRecord(value) || !isRecord(value.user)) {
        throw new Error("Triad returned an invalid session.");
      }

      return {
        user: {
          ...(typeof value.user.id === "string" ? { id: value.user.id } : {}),
          ...(typeof value.user.provider === "string" ? { provider: value.user.provider } : {}),
        },
      };
    }

    function decodeLinkedAccounts(value: unknown): LinkedAccount[] {
      if (!Array.isArray(value)) {
        throw new Error("Triad returned invalid linked identities.");
      }

      return value.map((account) => {
        if (!isRecord(account)) {
          throw new Error("Triad returned an invalid linked identity.");
        }

        return typeof account.providerId === "string" ? { providerId: account.providerId } : {};
      });
    }

    function decodeOAuthConsents(value: unknown): OAuthConsent[] {
      if (!Array.isArray(value)) {
        throw new Error("Triad returned invalid application consents.");
      }

      return value.map((consent) => {
        if (!isRecord(consent)) {
          throw new Error("Triad returned an invalid application consent.");
        }

        return {
          ...(typeof consent.clientId === "string" ? { clientId: consent.clientId } : {}),
          ...(typeof consent.id === "string" ? { id: consent.id } : {}),
          ...(Array.isArray(consent.resources) && consent.resources.every((resource) => typeof resource === "string")
            ? { resources: consent.resources }
            : {}),
          ...(Array.isArray(consent.scopes) && consent.scopes.every((scope) => typeof scope === "string")
            ? { scopes: consent.scopes }
            : {}),
          ...(typeof consent.updatedAt === "string" ? { updatedAt: consent.updatedAt } : {}),
        };
      });
    }
    const content = document.querySelector<HTMLElement>("#account-content")!;
    const signedOut = document.querySelector<HTMLElement>("#signed-out")!;
    const error = document.querySelector<HTMLElement>("#me-error")!;
    const retry = document.querySelector<HTMLButtonElement>("#account-retry")!;
    const logout = document.querySelector<HTMLButtonElement>("#logout")!;
    const deleteAccountButton = document.querySelector<HTMLButtonElement>("#delete-account")!;
    const appCount = document.querySelector<HTMLElement>("#app-count")!;
    const list = document.querySelector<HTMLElement>("#authorized-apps")!;
    const providerActions = document.querySelector<HTMLElement>("#account-provider-actions")!;
    const passkeyList = document.querySelector<HTMLElement>("#account-passkeys")!;
    const passkeyCount = document.querySelector<HTMLElement>("#passkey-count")!;
    const passkeyCopy = document.querySelector<HTMLElement>("#account-passkey-copy")!;
    const attachPasskeyForm = document.querySelector<HTMLFormElement>("#attach-passkey-form")!;
    const attachPasskeyButton = document.querySelector<HTMLButtonElement>("#attach-passkey")!;
    const attachedPasskeyName = document.querySelector<HTMLInputElement>("#attached-passkey-name")!;
    let loadController: AbortController | null = null;
    let loading = false;
    let activeAccountSub: string | undefined;
    let activeProvider: string | undefined;

    function showError(reason: unknown, fallback: string) {
      error.textContent = reason instanceof Error ? reason.message : fallback;
      error.hidden = false;
      retry.hidden = false;
      error.focus();
    }

    function setMutationControls(disabled: boolean) {
      logout.disabled = disabled;
      deleteAccountButton.disabled = disabled;
      attachPasskeyForm.querySelectorAll<HTMLButtonElement | HTMLInputElement>("button, input").forEach((control) => {
        control.disabled = disabled;
      });
      providerActions.querySelectorAll<HTMLButtonElement | HTMLInputElement>("button, input").forEach((control) => {
        control.disabled = disabled;
      });
      list.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
        button.disabled = disabled;
      });
    }

    function currentOAuthQuery(): string | undefined {
      if (!location.search || returnDestination()) {
        return undefined;
      }

      return inspectOAuthQuery(location.search).oauthQuery;
    }

    function returnDestination(): string | undefined {
      const query = new URLSearchParams(location.search);
      const values = query.getAll("return_to");
      if (values.length !== 1) {
        return undefined;
      }

      try {
        const target = new URL(values[0]!, location.origin);
        if (target.origin !== location.origin || target.pathname !== "/wallet/authorize") {
          return undefined;
        }

        return `${target.pathname}${target.search}${target.hash}`;
      } catch {
        return undefined;
      }
    }

    function requestedScopes(): readonly string[] {
      return location.search && !returnDestination()
        ? inspectOAuthQuery(location.search).scopes
        : ["openid"];
    }

    function requestedProvider(): "ethereum" | "passkey" | undefined {
      if (!location.search) {
        return undefined;
      }

      const provider = new URLSearchParams(location.hash.slice(1)).get("provider");

      return provider === "ethereum" || provider === "passkey" ? provider : undefined;
    }

    function supportsRequestedScopes(provider: string): boolean {
      if (!location.search) {
        return true;
      }
      const selectedProvider = requestedProvider();
      if (selectedProvider && provider !== selectedProvider) {
        return false;
      }

      const capabilities: Record<string, readonly string[]> = {
        google: ["openid", "email", "name", "avatar"],
        github: ["openid", "email", "handle", "name", "avatar"],
        twitter: ["openid", "handle", "name", "avatar"],
        ethereum: ["openid", "wallet", "chains", "chain_id"],
        passkey: ["openid", "handle", "cred", "pubkey", "cosekey"],
      };

      return requestedScopes().every((scope) => capabilities[provider]?.includes(scope));
    }

    function resumeAuthorization() {
      const destination = returnDestination();
      if (destination) {
        location.assign(destination);
        return;
      }

      const oauthQuery = currentOAuthQuery();
      location.assign(oauthQuery ? `/api/auth/oauth2/authorize?${oauthQuery}` : "/me");
    }

    async function signIn(provider: (typeof providers)[number], button: HTMLButtonElement) {
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = `OPENING ${provider.toUpperCase()}`;

      try {
        const oauthQuery = currentOAuthQuery();
        const response = await fetch("/api/auth/sign-in/social", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            provider,
            ...(oauthQuery
              ? { oauth_query: oauthQuery }
              : {
                  callbackURL: new URL(returnDestination() ?? "/me", location.origin).href,
                }),
          }),
        });
        const body = await jsonResponse(response, "Provider sign-in could not start.", (value) =>
          decodeOptionalString(value, "url", "Provider sign-in returned an invalid destination."),
        );
        if (!body.url) {
          throw new Error("Provider sign-in did not return a destination.");
        }

        location.assign(body.url);
      } catch (reason) {
        button.textContent = `RETRY ${provider.toUpperCase()}`;
        setMutationControls(false);
        showError(reason, "Provider sign-in could not start.");
      }
    }

    function ethereumProvider(): EthereumProvider {
      const candidate = Reflect.get(window, "ethereum");
      if (
        typeof candidate !== "object" ||
        candidate === null ||
        typeof Reflect.get(candidate, "request") !== "function"
      ) {
        throw new Error("No Ethereum wallet provider is available in this browser.");
      }

      return candidate as EthereumProvider;
    }

    function walletAddress(value: unknown): `0x${string}` {
      const address = Array.isArray(value) ? value[0] : undefined;
      if (typeof address !== "string" || !/^0x[0-9a-fA-F]{40}$/.test(address)) {
        throw new Error("The wallet did not return a valid Ethereum address.");
      }

      return address as `0x${string}`;
    }

    function walletChainId(value: unknown): number {
      if (typeof value !== "string" || !/^0x[0-9a-f]+$/i.test(value)) {
        throw new Error("The wallet did not return a valid chain ID.");
      }
      const chainId = Number.parseInt(value.slice(2), 16);
      if (!Number.isSafeInteger(chainId) || chainId <= 0) {
        throw new Error("The wallet did not return a valid chain ID.");
      }

      return chainId;
    }

    function siweMessage(address: string, chainId: number, nonce: string): string {
      const issuedAt = new Date();
      const expiresAt = new Date(issuedAt.getTime() + 5 * 60 * 1_000);

      return [
        `${location.host} wants you to sign in with your Ethereum account:`,
        address,
        "",
        "Sign in to Triad.",
        "",
        `URI: ${location.origin}`,
        "Version: 1",
        `Chain ID: ${chainId}`,
        `Nonce: ${nonce}`,
        `Issued At: ${issuedAt.toISOString()}`,
        `Expiration Time: ${expiresAt.toISOString()}`,
      ].join("\n");
    }

    async function signInWithEthereum(button: HTMLButtonElement) {
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = "CHECKING WALLET";

      try {
        const provider = ethereumProvider();
        const [accounts, rawChainId] = await Promise.all([
          provider.request({ method: "eth_requestAccounts" }),
          provider.request({ method: "eth_chainId" }),
        ]);
        const address = walletAddress(accounts);
        const chainId = walletChainId(rawChainId);
        const nonceResponse = await fetch("/api/auth/siwe/nonce", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ walletAddress: address, chainId }),
        });
        const { nonce } = await jsonResponse(
          nonceResponse,
          "Triad could not issue a wallet challenge.",
          (value) => decodeOptionalString(value, "nonce", "Triad returned an invalid wallet challenge."),
        );
        if (!nonce || !/^[A-Za-z0-9]{8,}$/.test(nonce)) {
          throw new Error("Triad returned an invalid wallet challenge.");
        }

        const message = siweMessage(address, chainId, nonce);
        button.textContent = "SIGN IN WALLET";
        const signature = await provider.request({
          method: "personal_sign",
          params: [message, address],
        });
        if (typeof signature !== "string" || !/^0x[0-9a-f]+$/i.test(signature)) {
          throw new Error("The wallet did not return a valid signature.");
        }

        const verifyResponse = await fetch("/api/auth/siwe/verify", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ message, signature, walletAddress: address, chainId }),
        });
        await jsonResponse(verifyResponse, "Triad rejected the wallet signature.", decodeNothing);
        resumeAuthorization();
      } catch (reason) {
        button.textContent = "RETRY ETHEREUM";
        setMutationControls(false);
        showError(reason, "Ethereum sign-in could not be completed.");
      }
    }

    async function authenticatePasskey(): Promise<void> {
      const optionsResponse = await fetch("/api/auth/passkey/generate-authenticate-options", {
        headers: { accept: "application/json" },
      });
      const options = await jsonResponse(
        optionsResponse,
        "Triad could not issue a passkey challenge.",
        decodeAuthenticationOptions,
      );
      const response = await startAuthentication({ optionsJSON: options });
      const serializedResponse = {
        ...response,
        clientExtensionResults: {},
      };
      const verifyResponse = await fetch("/api/auth/passkey/verify-authentication", {
        method: "POST",
        headers: { accept: "application/json", "content-type": "application/json" },
        body: JSON.stringify({ response: serializedResponse }),
      });
      await jsonResponse(verifyResponse, "Triad rejected the passkey assertion.", decodeNothing);
    }

    async function signInWithPasskey(button: HTMLButtonElement) {
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = "CHECKING PASSKEY";

      try {
        await authenticatePasskey();
        resumeAuthorization();
      } catch (reason) {
        button.textContent = "RETRY PASSKEY";
        setMutationControls(false);
        showError(reason, "Passkey sign-in could not be completed.");
      }
    }

    async function registerPasskey(button: HTMLButtonElement, usernameInput: HTMLInputElement) {
      if (!usernameInput.reportValidity()) {
        return;
      }

      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = "CREATING PASSKEY";

      try {
        const endpoint = new URL("/api/auth/passkey/generate-register-options", location.origin);
        endpoint.searchParams.set("context", usernameInput.value);
        const optionsResponse = await fetch(endpoint, {
          headers: { accept: "application/json" },
        });
        const options = await jsonResponse(
          optionsResponse,
          "Triad could not issue a passkey registration challenge.",
          decodeRegistrationOptions,
        );
        const userId = await passkeyWebAuthnUserId(options.user.name);
        const response = await startRegistration({
          optionsJSON: {
            ...options,
            user: { ...options.user, id: userId },
          },
        });
        const verifyResponse = await fetch("/api/auth/passkey/verify-registration", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ response, createSession: true }),
        });
        await jsonResponse(verifyResponse, "Triad rejected the passkey registration.", decodeNothing);

        resumeAuthorization();
      } catch (reason) {
        button.textContent = "RETRY REGISTER PASSKEY";
        setMutationControls(false);
        showError(reason, "Passkey registration could not be completed.");
      }
    }

    async function accountPasskeys(signal?: AbortSignal): Promise<AccountPasskey[]> {
      const response = await fetch("/api/wallet/passkeys", {
        method: "POST",
        headers: { accept: "application/json", "content-type": "application/json" },
        body: JSON.stringify({}),
        signal,
      });

      return jsonResponse(response, "Could not load account passkeys.", decodeAccountPasskeys);
    }

    // A wallet-broker failure must not hide sign-out and consent controls.
    async function loadableAccountPasskeys(
      signal: AbortSignal,
    ): Promise<AccountPasskey[] | undefined> {
      try {
        return await accountPasskeys(signal);
      } catch (reason) {
        if (reason instanceof DOMException && reason.name === "AbortError") {
          throw reason;
        }

        return undefined;
      }
    }

    async function removePasskey(passkey: AccountPasskey, button: HTMLButtonElement) {
      if (!window.confirm(`Remove ${passkey.name?.trim() || "this passkey"} from this Triad account?`)) {
        return;
      }

      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = "REMOVING PASSKEY";

      try {
        const response = await fetch("/api/auth/passkey/delete-passkey", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ id: passkey.id }),
        });
        await jsonResponse(response, "Could not remove this passkey.", decodeNothing);
        renderAccountPasskeys(await accountPasskeys());
      } catch (reason) {
        button.textContent = "RETRY REMOVE";
        showError(reason, "Could not remove this passkey.");
      } finally {
        setMutationControls(false);
      }
    }

    async function enableWalletCapability(passkey: AccountPasskey, button: HTMLButtonElement) {
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      button.textContent = "CHECKING PASSKEY";

      try {
        const optionsResponse = await fetch("/api/wallet/capability/options", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ credential_id: passkey.id }),
        });
        const capability = await jsonResponse(
          optionsResponse,
          "Triad could not issue the Wallet Capability challenge.",
          decodeWalletCapabilityOptions,
        );
        const assertion = await startAuthentication({
          optionsJSON: {
            ...capability.options,
            extensions: walletPrfExtension(capability.prf_salt),
          },
        });
        let prfRoot: Uint8Array<ArrayBuffer>;
        try {
          prfRoot = passkeyPrfResult(assertion.clientExtensionResults);
        } catch {
          throw new Error("This Passkey is not Wallet capable.");
        }
        button.textContent = "PROVING WALLET";
        const wallet = await signWithPrfWallet(
          prfRoot,
          capability.wallet_profile,
          capability.account_index,
          capability.signing_message,
        );
        const { clientExtensionResults: _privatePrfOutput, ...assertionWithoutExtensions } = assertion;
        const serverAssertion: AuthenticationResponseJSON = {
          ...assertionWithoutExtensions,
          clientExtensionResults: {},
        };
        const completeResponse = await fetch("/api/wallet/capability/complete", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({
            request_id: capability.request_id,
            response: serverAssertion,
            address: wallet.address,
            signature: wallet.signature,
          }),
        });
        await jsonResponse(completeResponse, "Triad rejected the Wallet Capability proof.", (value) => {
          if (!isRecord(value) || value.wallet_capable !== true) {
            throw new Error("Triad did not record Wallet Capability.");
          }

          return true;
        });
        renderAccountPasskeys(await accountPasskeys());
      } catch (reason) {
        button.textContent = "RETRY ENABLE WALLET";
        showError(reason, "Wallet Capability could not be established.");
      } finally {
        setMutationControls(false);
      }
    }

    function renderAccountPasskeys(passkeys: AccountPasskey[]) {
      passkeyList.replaceChildren();
      passkeyCount.textContent = String(passkeys.length);
      if (passkeys.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = "No passkey is attached to this account.";
        passkeyList.append(empty);
        return;
      }

      for (const passkey of passkeys) {
        const row = document.createElement("article");
        row.className = "account-passkey";
        const copy = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = passkey.name?.trim() || "Unnamed passkey";
        const detail = document.createElement("small");
        detail.textContent = `${passkey.backedUp ? "SYNCED" : "DEVICE-BOUND"} · ${isoDate(passkey.createdAt, "DATE UNAVAILABLE")}`;
        const badges = document.createElement("div");
        badges.className = "passkey-badges";
        const role = document.createElement("span");
        role.className = "passkey-required";
        role.textContent = passkey.role === "identity" ? "IDENTITY" : "ATTACHED";
        badges.append(role);
        if (passkey.walletCapable) {
          const wallet = document.createElement("span");
          wallet.className = "passkey-required";
          wallet.textContent = "WALLET";
          badges.append(wallet);
        }
        copy.append(title, badges, detail);

        const actions = document.createElement("div");
        actions.className = "passkey-actions";
        if (!passkey.walletCapable) {
          const enableWallet = document.createElement("button");
          enableWallet.className = "button secondary";
          enableWallet.type = "button";
          enableWallet.textContent = "ENABLE WALLET";
          enableWallet.addEventListener("click", () => {
            void enableWalletCapability(passkey, enableWallet);
          });
          actions.append(enableWallet);
        }
        if (passkey.removable) {
          const remove = document.createElement("button");
          remove.className = "button danger";
          remove.type = "button";
          remove.textContent = "REMOVE PASSKEY";
          remove.addEventListener("click", () => {
            void removePasskey(passkey, remove);
          });
          actions.append(remove);
        }
        row.append(copy, actions);
        passkeyList.append(row);
      }
    }

    function renderPasskeysUnavailable() {
      passkeyList.replaceChildren();
      passkeyCount.textContent = "—";
      const notice = document.createElement("p");
      notice.className = "empty-state";
      notice.textContent = "Passkeys are unavailable right now. Reload the page to try again.";
      passkeyList.append(notice);
    }

    async function attachPasskey() {
      if (!activeAccountSub || !attachPasskeyForm.reportValidity()) {
        return;
      }

      const name = attachedPasskeyName.value.trim();
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      attachPasskeyButton.textContent = "CREATING PASSKEY";

      try {
        const endpoint = new URL("/api/auth/passkey/generate-register-options", location.origin);
        endpoint.searchParams.set("name", name);
        const optionsResponse = await fetch(endpoint, { headers: { accept: "application/json" } });
        const options = await jsonResponse(
          optionsResponse,
          "Triad could not issue a passkey registration challenge.",
          decodeRegistrationOptions,
        );
        const response = await startRegistration({
          optionsJSON: {
            ...options,
            user: { ...options.user, id: accountSubjectWebAuthnUserId(activeAccountSub) },
          },
        });
        const verifyResponse = await fetch("/api/auth/passkey/verify-registration", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: JSON.stringify({ response, name }),
        });
        await jsonResponse(verifyResponse, "Triad rejected the passkey registration.", decodeNothing);

        attachedPasskeyName.value = "";
        renderAccountPasskeys(await accountPasskeys());
        attachPasskeyButton.textContent = "ATTACH PASSKEY";
      } catch (reason) {
        attachPasskeyButton.textContent = "RETRY ATTACH PASSKEY";
        showError(reason, "Passkey attachment could not be completed.");
      } finally {
        setMutationControls(false);
      }
    }

    function renderProviderActions() {
      providerActions.replaceChildren();
      for (const provider of providers) {
        if (!supportsRequestedScopes(provider)) {
          continue;
        }
        const button = document.createElement("button");
        button.className = "button primary";
        button.type = "button";
        button.textContent = `CONTINUE WITH ${provider.toUpperCase()}`;
        button.addEventListener("click", () => {
          void signIn(provider, button);
        });
        providerActions.append(button);
      }

      if (supportsRequestedScopes("ethereum")) {
        const ethereum = document.createElement("button");
        ethereum.className = "button primary";
        ethereum.type = "button";
        ethereum.textContent = "CONTINUE WITH ETHEREUM";
        ethereum.addEventListener("click", () => {
          void signInWithEthereum(ethereum);
        });
        providerActions.append(ethereum);
      }

      if (supportsRequestedScopes("passkey")) {
        const passkey = document.createElement("button");
        passkey.className = "button primary";
        passkey.type = "button";
        passkey.textContent = "CONTINUE WITH PASSKEY";
        passkey.addEventListener("click", () => {
          void signInWithPasskey(passkey);
        });

        const registration = document.createElement("form");
        registration.className = "passkey-registration";

        const usernameLabel = document.createElement("label");
        usernameLabel.htmlFor = "passkey-username";
        usernameLabel.textContent = "NEW PASSKEY USERNAME";

        const username = document.createElement("input");
        username.id = "passkey-username";
        username.name = "passkey-username";
        username.type = "text";
        username.autocomplete = "username";
        username.autocapitalize = "none";
        username.spellcheck = false;
        username.minLength = 3;
        username.maxLength = 24;
        username.pattern = "[A-Za-z0-9][A-Za-z0-9-]{2,23}";
        username.placeholder = "alice";
        username.required = true;
        username.title = "Use 3 to 24 letters, numbers, or hyphens.";

        const register = document.createElement("button");
        register.className = "button secondary";
        register.type = "submit";
        register.textContent = "REGISTER A PASSKEY";
        registration.addEventListener("submit", (event) => {
          event.preventDefault();
          void registerPasskey(register, username);
        });

        registration.append(usernameLabel, username, register);
        providerActions.append(passkey, registration);
      }

      if (providerActions.childElementCount === 0) {
        const unavailable = document.createElement("p");
        unavailable.className = "error-message";
        unavailable.textContent =
          "No single identity can disclose every requested claim. Return to the application and request scopes supported by one provider.";
        providerActions.append(unavailable);
      }
    }

    async function publicClient(clientId: string, signal: AbortSignal): Promise<PublicClient> {
      const endpoint = new URL("/api/auth/oauth2/public-client", location.origin);
      endpoint.searchParams.set("client_id", clientId);
      const response = await fetch(endpoint, {
        headers: { accept: "application/json" },
        signal,
      });

      return jsonResponse(response, `Could not load client ${clientId}.`, decodePublicClient);
    }

    async function removeConsent(consentId: string, row: HTMLElement) {
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;

      try {
        const response = await fetch("/api/auth/oauth2/delete-consent", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({ id: consentId }),
        });
        if (!response.ok) {
          throw responseError(await response.json(), "Could not remove this consent.");
        }

        row.remove();
        const remaining = list.querySelectorAll(".authorized-app").length;
        appCount.textContent = String(remaining);
        if (remaining === 0) {
          const empty = document.createElement("p");
          empty.className = "empty-state";
          empty.textContent = "No downstream applications are authorized.";
          list.append(empty);
        }
      } catch (reason) {
        showError(reason, "Could not remove this consent.");
      } finally {
        setMutationControls(false);
      }
    }

    async function renderConsents(consents: OAuthConsent[], signal: AbortSignal) {
      const completeConsents = consents.filter(
        (consent): consent is OAuthConsent & { clientId: string; id: string } =>
          typeof consent.clientId === "string" && typeof consent.id === "string",
      );
      const clients = await Promise.all(
        completeConsents.map((consent) => publicClient(consent.clientId, signal)),
      );

      list.replaceChildren();
      appCount.textContent = String(completeConsents.length);
      if (completeConsents.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = "No downstream applications are authorized.";
        list.append(empty);
        return;
      }

      completeConsents.forEach((consent, index) => {
        const client = clients[index];
        const row = document.createElement("article");
        row.className = "authorized-app";

        const copy = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = client?.client_name?.trim() || consent.clientId;
        const id = document.createElement("code");
        id.textContent = client?.client_id ?? consent.clientId;
        const details = document.createElement("small");
        details.textContent = [
          consent.scopes?.join(" ") || "openid",
          consent.resources?.join(" · ") || "no resource recorded",
        ].join(" / ");
        copy.append(title, details);
        const button = document.createElement("button");
        button.className = "button danger";
        button.type = "button";
        button.textContent = "REMOVE CONSENT";
        button.addEventListener("click", () => {
          void removeConsent(consent.id, row);
        });

        row.append(copy, id, button);
        list.append(row);
      });
    }

    async function signOut() {
      setMutationControls(true);
      logout.textContent = "SIGNING OUT";
      error.hidden = true;
      retry.hidden = true;

      try {
        const response = await fetch("/api/auth/sign-out", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: "{}",
        });
        if (!response.ok) {
          throw responseError(await response.json(), "Could not sign out.");
        }

        location.reload();
      } catch (reason) {
        logout.textContent = "RETRY SIGN OUT";
        setMutationControls(false);
        showError(reason, "Could not sign out.");
      }
    }

    async function deleteAccount() {
      if (!window.confirm("Delete this Triad account and its stored authorization records?")) {
        return;
      }

      setMutationControls(true);
      deleteAccountButton.textContent = "DELETING ACCOUNT";
      error.hidden = true;
      retry.hidden = true;

      try {
        const response = await fetch("/api/auth/delete-user", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({}),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => undefined);
          throw responseError(body, "Could not delete this account.");
        }

        location.assign("/me");
      } catch (reason) {
        deleteAccountButton.textContent = "RETRY DELETE ACCOUNT";
        setMutationControls(false);
        showError(reason, "Could not delete this account.");
      }
    }

    async function load() {
      if (loading) {
        return;
      }

      loading = true;
      loadController?.abort();
      const controller = new AbortController();
      loadController = controller;
      setMutationControls(true);
      error.hidden = true;
      retry.hidden = true;
      document.querySelector("#account-summary")!.textContent = "Loading your session...";

      try {
        const sessionResponse = await fetch("/api/auth/get-session", {
          headers: { accept: "application/json" },
          signal: controller.signal,
        });
        const session = await jsonResponse(sessionResponse, "Could not load your session.", decodeSession);
        if (!session?.user?.id) {
          activeAccountSub = undefined;
          activeProvider = undefined;
          document.querySelector("#account-summary")!.textContent =
            "No active authorization session on this browser.";
          content.hidden = true;
          signedOut.hidden = false;
          renderProviderActions();
          return;
        }

        activeAccountSub = session.user.id;
        activeProvider = session.user.provider;
        attachPasskeyForm.hidden = activeProvider === "ethereum";
        attachPasskeyButton.textContent = "ATTACH PASSKEY";
        passkeyCopy.textContent =
          activeProvider === "ethereum"
            ? "An EVM Identity Source uses its external wallet and cannot attach passkeys."
            : "Identity and Attached Passkeys can authenticate this Triad Account. Enable Wallet Capability on any Passkey that supports PRF.";
        const [accountsResponse, consentsResponse, passkeys] = await Promise.all([
          fetch("/api/auth/list-accounts", {
            headers: { accept: "application/json" },
            signal: controller.signal,
          }),
          fetch("/api/auth/oauth2/get-consents", {
            headers: { accept: "application/json" },
            signal: controller.signal,
          }),
          loadableAccountPasskeys(controller.signal),
        ]);
        const accounts = await jsonResponse(
          accountsResponse,
          "Could not load linked identities.",
          decodeLinkedAccounts,
        );
        const consents = await jsonResponse(
          consentsResponse,
          "Could not load authorized applications.",
          decodeOAuthConsents,
        );

        document.querySelector("#account-summary")!.textContent =
          "This is the identity map and authorization ledger Triad holds for you.";
        document.querySelector("#account-sub")!.textContent = session.user.id;
        const identities = new Set(
          [session.user.provider, ...accounts.map((account) => account.providerId)]
            .filter((provider): provider is string => typeof provider === "string")
            .map((provider) => (provider === "siwe" ? "ethereum" : provider).toUpperCase()),
        );
        document.querySelector("#identity-list")!.textContent = [...identities].join(" · ") || "NONE";
        if (passkeys) {
          renderAccountPasskeys(passkeys);
        } else {
          renderPasskeysUnavailable();
        }
        await renderConsents(consents, controller.signal);
        signedOut.hidden = true;
        content.hidden = false;
      } catch (reason) {
        if (reason instanceof DOMException && reason.name === "AbortError") {
          return;
        }

        showError(reason, "Could not load your session.");
      } finally {
        if (loadController === controller) {
          loadController = null;
          loading = false;
          setMutationControls(false);
        }
      }
    }

    logout.addEventListener("click", () => {
      void signOut();
    });
    deleteAccountButton.addEventListener("click", () => {
      void deleteAccount();
    });
    attachPasskeyForm.addEventListener("submit", (event) => {
      event.preventDefault();
      void attachPasskey();
    });
    retry.addEventListener("click", () => {
      void load();
    });
    window.addEventListener("pagehide", () => {
      loadController?.abort();
    });
    void load();
  </script>
</Shell>
