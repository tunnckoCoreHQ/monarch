---
import Shell from "../components/Shell.astro";

export const prerender = true;
---

<Shell title="Authorize app | Triad" mode="product">
  <section class="transaction shell narrow" aria-labelledby="consent-title">
    <div class="transaction-head">
      <p>CHECK THE CONNECTION</p>
      <h1 id="consent-title">IDENTITY<br /><span>HANDSHAKE.</span></h1>
      <p id="consent-summary" class="lede">Loading the authorization request...</p>
    </div>

    <div id="consent-panel" class="transaction-panel" aria-live="polite" aria-busy="true">
      <div class="request-party">
        <div class="app-glyph" aria-hidden="true">?</div>
        <div><span id="client-kind">APPLICATION</span><strong id="client-name">LOADING...</strong></div>
        <div><span>RESOURCE</span><strong id="resource-name">PENDING</strong></div>
      </div>
      <div id="consent-disclosures" class="disclosure-list"></div>
    </div>

    <p id="consent-error" class="error-message" role="alert" tabindex="-1" hidden></p>
    <div class="actions transaction-actions">
      <button id="approve" class="button primary" type="button" disabled>APPROVE CONNECTION</button>
      <button id="deny" class="button secondary" type="button" disabled>CANCEL</button>
      <a id="consent-restart" class="button secondary" href="/demo" hidden>RETURN TO DEMO</a>
    </div>
    <p class="fine-print">
      Approval shares every claim listed above. The app never receives the provider access token. Triad stores
      approved scope names. Claims become non-exchangeable at expiry. Physical encrypted-row deletion is
      bounded, traffic-driven cleanup and can occur later.
    </p>
  </section>

  <script>
    import { renderDisclosures } from "../scripts/disclosure-controls";
    import { inspectOAuthQuery } from "../scripts/demo-protocol";

    const panel = document.querySelector<HTMLElement>("#consent-panel")!;
    const approve = document.querySelector<HTMLButtonElement>("#approve")!;
    const deny = document.querySelector<HTMLButtonElement>("#deny")!;
    const error = document.querySelector<HTMLElement>("#consent-error")!;
    const restart = document.querySelector<HTMLAnchorElement>("#consent-restart")!;
    const disclosures = document.querySelector<HTMLElement>("#consent-disclosures")!;
    let inspected: ReturnType<typeof inspectOAuthQuery> | null = null;

    function resetActions() {
      approve.textContent = "APPROVE CONNECTION";
      deny.textContent = "CANCEL";
    }

    function fail(message: string) {
      resetActions();
      error.textContent = message;
      error.hidden = false;
      restart.hidden = false;
      panel.setAttribute("aria-busy", "false");
      approve.disabled = true;
      deny.disabled = true;
      error.focus();
    }

    async function act(action: "approve" | "deny") {
      if (!inspected) {
        fail("This request is not ready. Return to the demo and start it again.");
        return;
      }

      approve.disabled = true;
      deny.disabled = true;
      error.hidden = true;
      restart.hidden = true;
      const active = action === "approve" ? approve : deny;
      active.textContent = action === "approve" ? "APPROVING CONNECTION" : "CANCELLING";
      try {
        const response = await fetch("/api/auth/oauth2/consent", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            accept: action === "approve",
            scope: inspected.scopes.join(" "),
            oauth_query: inspected.oauthQuery,
          }),
        });
        const body = (await response.json()) as { url?: string; error_description?: string };
        if (!response.ok || !body.url) {
          fail(body.error_description ?? "This request could not be completed. Return to the demo and try again.");
          return;
        }

        location.assign(body.url);
      } catch {
        fail("The authorization server could not complete this request. Return to the demo and try again.");
      }
    }

    async function loadRequest() {
      inspected = inspectOAuthQuery(location.search);
      const endpoint = new URL("/api/auth/oauth2/public-client", location.origin);
      endpoint.searchParams.set("client_id", inspected.clientId);
      const response = await fetch(endpoint, { headers: { accept: "application/json" } });
      const client = (await response.json()) as {
        client_id?: string;
        client_name?: string;
        error_description?: string;
      };
      if (!response.ok || client.client_id !== inspected.clientId) {
        throw new Error(client.error_description ?? "This authorization request expired.");
      }

      const clientDisplay = client.client_name?.trim() || client.client_id;
      document.querySelector("#client-name")!.textContent = clientDisplay;
      document.querySelector("#resource-name")!.textContent = inspected.resources.join(" · ");
      document.querySelector("#consent-summary")!.textContent =
        `${clientDisplay} requests identity for ${inspected.resources.join(", ")}. Review every claim before approving.`;
      document.querySelector(".app-glyph")!.textContent = clientDisplay.slice(0, 1).toUpperCase();
      renderDisclosures(disclosures, inspected.scopes);
      panel.setAttribute("aria-busy", "false");
      approve.disabled = false;
      deny.disabled = false;
    }

    approve.addEventListener("click", () => {
      void act("approve");
    });
    deny.addEventListener("click", () => {
      void act("deny");
    });
    loadRequest().catch((reason: unknown) => {
      fail(reason instanceof Error ? reason.message : "The authorization server could not load this request.");
    });
  </script>
</Shell>
