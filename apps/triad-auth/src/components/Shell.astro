---
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  mode?: "brand" | "product";
}

const {
  title,
  description = "A small identity broker with explicit provider-global, account, and per-app identifiers.",
  mode = "brand",
} = Astro.props;

const commit = import.meta.env.COMMIT_SHA;
const commitHref =
  commit === "local"
    ? "https://github.com/tunnckoCore/triad-auth"
    : `https://github.com/tunnckoCore/triad-auth/commit/${commit}`;
---

<!doctype html>
<html lang="en" data-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(0.08 0 0)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Triad home">triad<span>/</span></a>
      <nav aria-label="Main navigation">
        <a class="nav-demo" href="/demo">DEMO</a>
        <a href="/me">ACCOUNT</a>
        <a class="nav-secondary" href="/api/auth/.well-known/openid-configuration">DISCOVERY</a>
        <a href="https://github.com/tunnckoCore/triad-auth">SOURCE ↗</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer shell">
      <a href="/demo">TRY TRIAD</a>
      <a href="/api/auth/.well-known/openid-configuration">DISCOVERY</a>
      <a href="/me">ACCOUNT</a>
      <a href="/privacy">PRIVACY</a>
      <a href="/terms">TERMS</a>
      <a href="https://github.com/tunnckoCore/triad-auth">SOURCE ↗</a>
      <a href={commitHref} title={commit}>BUILD {commit.slice(0, 7)} ↗</a>
    </footer>
  </body>
</html>
