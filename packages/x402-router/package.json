{
  "name": "@tunnckocore/x402-router",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cdp": "./src/cdp.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cdp": {
        "types": "./dist/cdp.d.ts",
        "default": "./dist/cdp.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite fix --type-aware --type-check",
    "test": "vitest run"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "@x402/hono": "catalog:",
    "@x402/svm": "catalog:",
    "hono": "catalog:",
    "tsdown": "catalog:"
  }
}
