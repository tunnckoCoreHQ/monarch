{
  "name": "@tunnckocore/ethscriptions-server",
  "version": "0.14.0",
  "description": "Enhanced Ethscriptions API server. Caches, validates inputs and outputs with Zod, and unifies Ethscriptions API's responses, according to ESIP-9. Includes support for resolving ENS on-chain / off-chain names, and Ethscriptions names.",
  "homepage": "https://github.com/tunnckoCoreHQ/monarch/tree/master/packages/ethscriptions-server",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCoreHQ/monarch.git",
    "directory": "packages/ethscriptions-server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite fix --type-aware --type-check",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@tunnckocore/ethscriptions-core": "workspace:^",
    "file-type": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
