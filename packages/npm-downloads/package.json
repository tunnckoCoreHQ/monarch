{
  "name": "@tunnckocore/npm-downloads",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCoreHQ/monarch.git",
    "directory": "packages/npm-downloads"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite fix --type-aware --type-check",
    "coverage:badge": "node ../../scripts/coverage-badge.ts",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
