---
import Shell from "../../components/Shell.astro";

export const prerender = true;
---

<Shell title="Authorize device | Triad" mode="product">
  <section class="transaction shell narrow" aria-labelledby="device-title">
    <div class="transaction-head">
      <p>DEVICE AUTHORIZATION</p>
      <h1 id="device-title">AUTHORIZE<br /><span>THIS REQUEST.</span></h1>
      <p id="device-summary" class="lede" aria-live="polite">
        Checking this browser for an active Triad session.
      </p>
    </div>

    <div id="device-sign-in" class="transaction-panel" hidden>
      <p>A Triad session is required before this browser can approve a device request.</p>
      <div class="actions transaction-actions">
        <a class="button primary" href="/me">OPEN YOUR TRIAD SESSION</a>
      </div>
    </div>

    <form id="device-form" class="device-form" aria-busy="true" hidden>
      <label for="user-code">DEVICE CODE</label>
      <input
        id="user-code"
        name="user_code"
        inputmode="text"
        autocomplete="one-time-code"
        maxlength="9"
        placeholder="ABCD-2345"
        required
      />
      <div class="device-app" aria-label="Device authorization request">
        <div><span>ACTIVE ACCOUNT SUB</span><strong id="device-account">PENDING</strong></div>
        <div><span>CLIENT ID</span><strong id="device-client">PENDING</strong></div>
        <div><span>RESULT</span><strong id="device-contract">PENDING</strong></div>
        <div><span>RESOURCE</span><strong id="device-resource">PENDING</strong></div>
      </div>
      <div id="device-disclosures" class="disclosure-list" hidden></div>
      <p id="device-status" class="demo-status" aria-live="polite">
        Enter all eight characters to inspect the request.
      </p>
      <div id="device-actions" class="actions transaction-actions">
        <button id="device-approve" class="button primary" type="submit" disabled>
          APPROVE REQUEST
        </button>
        <button id="device-deny" class="button secondary" type="button" disabled>
          DENY REQUEST
        </button>
      </div>
    </form>

    <div id="device-result" class="transaction-panel" aria-live="polite" hidden>
      <strong id="device-result-title">DEVICE AUTHORIZED</strong>
      <p id="device-result-copy"></p>
    </div>
    <p id="device-error" class="error-message" role="alert" tabindex="-1" hidden></p>
    <button id="device-retry" class="button secondary" type="button" hidden>RETRY SESSION CHECK</button>
    <p class="fine-print">
      Approval lets the requesting device redeem this code. A first-party Triad device receives a session. A
      registered OAuth client receives scoped OAuth tokens. Continue only when the code exactly matches.
    </p>
  </section>

  <script>
    import { renderDisclosures } from "../../scripts/disclosure-controls";
    import { responseError } from "../../utils";

    type SessionResult = { user?: { id?: string } } | null;
    type DeviceResult = {
      client_id?: string;
      error?: string;
      error_description?: string;
      message?: string;
      resource?: string | string[];
      scope?: string;
      status?: string;
      success?: boolean;
    };
    type DeviceDisclosureResult = {
      error?: string;
      scopes?: string[];
    };

    const summary = document.querySelector<HTMLElement>("#device-summary")!;
    const signedOut = document.querySelector<HTMLElement>("#device-sign-in")!;
    const form = document.querySelector<HTMLFormElement>("#device-form")!;
    const input = document.querySelector<HTMLInputElement>("#user-code")!;
    const account = document.querySelector<HTMLElement>("#device-account")!;
    const client = document.querySelector<HTMLElement>("#device-client")!;
    const contract = document.querySelector<HTMLElement>("#device-contract")!;
    const requestedResource = document.querySelector<HTMLElement>("#device-resource")!;
    const disclosures = document.querySelector<HTMLElement>("#device-disclosures")!;
    const status = document.querySelector<HTMLElement>("#device-status")!;
    const actions = document.querySelector<HTMLElement>("#device-actions")!;
    const approve = document.querySelector<HTMLButtonElement>("#device-approve")!;
    const deny = document.querySelector<HTMLButtonElement>("#device-deny")!;
    const result = document.querySelector<HTMLElement>("#device-result")!;
    const resultTitle = document.querySelector<HTMLElement>("#device-result-title")!;
    const resultCopy = document.querySelector<HTMLElement>("#device-result-copy")!;
    const error = document.querySelector<HTMLElement>("#device-error")!;
    const retry = document.querySelector<HTMLButtonElement>("#device-retry")!;
    const fromUrl = new URLSearchParams(location.search).get("user_code") ?? "";
    let sessionUserId: string | null = null;
    let requestKind: "oauth" | "session" | null = null;
    let inspection = 0;

    function formatCode(value: string): string {
      const clean = value
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "")
        .slice(0, 8);

      return clean.length > 4 ? `${clean.slice(0, 4)}-${clean.slice(4)}` : clean;
    }

    function hasCompleteCode(): boolean {
      return input.value.replace(/[^A-Z0-9]/g, "").length === 8;
    }

    function clearError() {
      error.hidden = true;
      retry.hidden = true;
    }

    function showError(reason: unknown, fallback: string, retryLabel: string) {
      error.textContent = reason instanceof Error ? reason.message : fallback;
      error.hidden = false;
      retry.textContent = retryLabel;
      retry.hidden = false;
      error.focus();
    }

    function setDecisionAvailable(available: boolean) {
      approve.disabled = !available;
      deny.disabled = !available;
    }

    function resetInspection() {
      inspection += 1;
      setDecisionAvailable(false);
      disclosures.replaceChildren();
      disclosures.hidden = true;
      client.textContent = "PENDING";
      contract.textContent = "PENDING";
      requestedResource.textContent = "PENDING";
      requestKind = null;
      actions.hidden = false;
      result.hidden = true;
      form.setAttribute("aria-busy", "false");
      status.textContent = "Enter all eight characters to inspect the request.";
      status.dataset.tone = "working";
      clearError();
    }

    async function inspect() {
      if (!sessionUserId || !hasCompleteCode()) {
        return;
      }

      const current = ++inspection;
      setDecisionAvailable(false);
      clearError();
      form.setAttribute("aria-busy", "true");
      status.textContent = "Checking this device code.";
      status.dataset.tone = "working";

      try {
        const response = await fetch(
          `/api/auth/device?user_code=${encodeURIComponent(input.value)}`,
          { headers: { accept: "application/json" } },
        );
        const body = (await response.json()) as DeviceResult;
        if (current !== inspection) {
          return;
        }
        if (!response.ok) {
          throw responseError(body, "That device code is invalid or expired.");
        }
        if (body.status !== "pending") {
          status.textContent = `This request is already ${body.status ?? "processed"}.`;
          status.dataset.tone = "error";
          return;
        }
        if (!body.client_id) {
          throw new Error("The device request has no client identity.");
        }

        requestKind = body.client_id === location.origin ? "session" : "oauth";
        client.textContent = body.client_id;
        contract.textContent = requestKind === "oauth" ? "OAUTH TOKENS" : "TRIAD SESSION";
        requestedResource.textContent =
          typeof body.resource === "string"
            ? body.resource
            : Array.isArray(body.resource)
              ? body.resource.join(" ")
              : "FIRST-PARTY SESSION";

        const disclosureResponse = await fetch(
          `/api/auth/device/disclosure?user_code=${encodeURIComponent(input.value)}`,
          { headers: { accept: "application/json" } },
        );
        const disclosureBody = (await disclosureResponse.json()) as DeviceDisclosureResult;
        if (current !== inspection) {
          return;
        }
        if (!disclosureResponse.ok || !Array.isArray(disclosureBody.scopes)) {
          throw responseError(disclosureBody, "The requested disclosures could not be inspected.");
        }

        renderDisclosures(disclosures, disclosureBody.scopes);
        disclosures.hidden = false;

        setDecisionAvailable(true);
        status.textContent = "Request found. Match the code on the requesting device before deciding.";
        status.dataset.tone = "success";
      } catch (reason) {
        if (current !== inspection) {
          return;
        }

        status.textContent = "The request could not be verified.";
        status.dataset.tone = "error";
        showError(reason, "The device request could not be inspected.", "RETRY REQUEST");
      } finally {
        if (current === inspection) {
          form.setAttribute("aria-busy", "false");
        }
      }
    }

    async function decide(action: "approve" | "deny") {
      if (!sessionUserId || !hasCompleteCode()) {
        showError(
          new Error("Inspect a valid device code before deciding."),
          "The request is not ready.",
          "RETRY REQUEST",
        );
        return;
      }

      setDecisionAvailable(false);
      input.disabled = true;
      clearError();
      form.setAttribute("aria-busy", "true");
      const active = action === "approve" ? approve : deny;
      const endpoint =
        action === "approve" ? "/api/auth/device/approve" : "/api/auth/device/deny";
      active.textContent = action === "approve" ? "APPROVING REQUEST" : "DENYING REQUEST";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({ userCode: input.value }),
        });
        const body = (await response.json()) as DeviceResult;
        if (!response.ok || body.success !== true) {
          throw responseError(body, "The device request could not be completed.");
        }

        actions.hidden = true;
        resultTitle.textContent = action === "approve" ? "DEVICE AUTHORIZED" : "REQUEST DENIED";
        resultCopy.textContent =
          action === "approve"
            ? requestKind === "oauth"
              ? "The registered client may now redeem its code for scoped OAuth tokens."
              : "The first-party device may now redeem its code for a Triad session."
            : "The requesting device cannot redeem this code.";
        result.hidden = false;
        status.textContent = action === "approve" ? "Device authorization complete." : "Request denied.";
        status.dataset.tone = "success";
      } catch (reason) {
        input.disabled = false;
        setDecisionAvailable(true);
        status.textContent = "The request was not changed.";
        status.dataset.tone = "error";
        showError(reason, "The device request could not be completed.", "RETRY REQUEST");
      } finally {
        active.textContent = action === "approve" ? "APPROVE REQUEST" : "DENY REQUEST";
        form.setAttribute("aria-busy", "false");
      }
    }

    async function loadSession() {
      inspection += 1;
      sessionUserId = null;
      signedOut.hidden = true;
      form.hidden = true;
      clearError();
      summary.textContent = "Checking this browser for an active Triad session.";

      try {
        const response = await fetch("/api/auth/get-session", {
          headers: { accept: "application/json" },
        });
        const session = (await response.json()) as SessionResult;
        if (!response.ok) {
          throw new Error("The browser session could not be checked.");
        }
        if (!session?.user?.id) {
          summary.textContent = "Sign in before authorizing a device request.";
          signedOut.hidden = false;
          return;
        }

        sessionUserId = session.user.id;
        account.textContent = sessionUserId;
        summary.textContent = "Review the requesting client before authorizing this account.";
        form.hidden = false;
        form.setAttribute("aria-busy", "false");
        if (hasCompleteCode()) {
          await inspect();
        }
      } catch (reason) {
        summary.textContent = "The browser session could not be checked.";
        showError(reason, "The browser session could not be checked.", "RETRY SESSION CHECK");
      }
    }

    input.value = formatCode(fromUrl);
    input.addEventListener("input", () => {
      input.value = formatCode(input.value);
      resetInspection();
      if (hasCompleteCode()) {
        void inspect();
      }
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void decide("approve");
    });
    deny.addEventListener("click", () => {
      void decide("deny");
    });
    retry.addEventListener("click", () => {
      if (sessionUserId) {
        void inspect();
        return;
      }

      void loadSession();
    });
    void loadSession();
  </script>
</Shell>
