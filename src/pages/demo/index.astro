---
import Shell from "../../components/Shell.astro";

export const prerender = true;
---

<Shell
  title="Try the broker | Triad"
  description="Run Triad's browser OAuth, first-party device login, and OAuth device flows."
  mode="product"
>
  <section class="transaction shell demo" aria-labelledby="demo-title">
    <div class="transaction-head demo-head">
      <p>TRY TRIAD</p>
      <h1 id="demo-title">ONE REQUEST.<br /><span>THREE FLOWS.</span></h1>
      <p class="lede">
        Configure the identity request, then use browser OAuth, first-party device login, or a registered OAuth
        device client.
      </p>
    </div>

    <section class="demo-request" aria-labelledby="demo-request-title">
      <div class="demo-request-heading">
        <h2 id="demo-request-title">CONFIGURE THE CLIENT REQUEST</h2>
        <p>
          Requested profile claims default off here. Any selected claim is required for the transaction and
          shown again at consent.
        </p>
      </div>
      <div class="provider-control">
        <label for="demo-provider">PROVIDER</label>
        <select id="demo-provider" disabled aria-describedby="provider-status"></select>
      </div>
      <fieldset id="scope-fieldset" disabled>
        <legend>OPTIONAL CLAIM REQUEST</legend>
        <div class="scope-selector">
          <label
            ><input type="checkbox" name="demo-scope" value="email" /><span
              >EMAIL<small>email + email_verified</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="handle" /><span
              >HANDLE<small>preferred_username</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="name" /><span>NAME<small>name</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="avatar" /><span
              >AVATAR<small>picture</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="wallet" /><span
              >WALLET<small>wallet</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="chains" /><span
              >CHAINS<small>chains</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="chain_id" /><span
              >CURRENT CHAIN<small>chain_id</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="cred" /><span
              >CREDENTIAL<small>cred</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="pubkey" /><span
              >PUBLIC KEY<small>pubkey</small></span
            ></label
          >
          <label
            ><input type="checkbox" name="demo-scope" value="cosekey" /><span
              >COSE KEY<small>cosekey</small></span
            ></label
          >
        </div>
      </fieldset>
      <p id="provider-status" class="control-status" aria-live="polite">
        Choose a provider. Unsupported claims remain unavailable.
      </p>
      <dl class="protocol-list demo-request-ledger">
        <div><dt>CLIENT ID</dt><dd id="demo-client-id">ISSUED ON START</dd></div>
        <div><dt>RESOURCE</dt><dd id="demo-resource">LOADING</dd></div>
        <div><dt>SCOPE</dt><dd id="demo-scope-request">openid</dd></div>
      </dl>
    </section>

    <div class="demo-grid">
      <section class="demo-bay" aria-labelledby="browser-demo-title">
        <div class="demo-bay-head">
          <div>
            <span class="demo-index">01 / BROWSER</span>
            <h2 id="browser-demo-title">AUTHORIZATION CODE + PKCE</h2>
          </div>
          <span class="status-mark" aria-hidden="true"></span>
        </div>
        <p>
          Triad creates a 64-byte verifier, sends only its S256 challenge, checks state, exchanges the code once,
          and verifies the returned ES256 token against JWKS.
        </p>
        <dl class="protocol-list">
          <div><dt>AUTH SERVER</dt><dd id="demo-issuer">loading</dd></div>
          <div><dt>CLIENT TYPE</dt><dd>PUBLIC / NONE</dd></div>
          <div><dt>VERIFICATION</dt><dd>ES256 + JWKS</dd></div>
        </dl>
        <p id="browser-status" class="demo-status" aria-live="polite">
          Loading authorization server metadata.
        </p>
        <button id="browser-start" class="button primary demo-action" type="button" disabled
          >START BROWSER FLOW</button
        >
      </section>

      <section class="demo-bay" aria-labelledby="device-demo-title">
        <div class="demo-bay-head">
          <div>
            <span class="demo-index">02 / DEVICE</span>
            <h2 id="device-demo-title">TWO DEVICE CONTRACTS</h2>
          </div>
          <span class="status-mark" aria-hidden="true"></span>
        </div>
        <p>
          Authorize a Triad session on another device, or issue OAuth tokens to a registered device client. Both
          use the same browser approval step and different token endpoints.
        </p>
        <div id="device-instructions" class="device-ticket" hidden>
          <span>USER CODE</span>
          <strong id="demo-user-code"></strong>
          <small id="device-client-id"></small>
          <a id="verification-link" class="text-link" href="/device/verify" target="_blank" rel="noopener"
            >OPEN VERIFICATION PAGE ↗</a
          >
          <small id="device-expiry"></small>
        </div>
        <p id="device-status" class="demo-status" aria-live="polite">No device request is active.</p>
        <div class="actions">
          <button id="device-session-start" class="button primary demo-action" type="button" disabled
            >AUTHORIZE TRIAD SESSION</button
          >
          <button id="device-oauth-start" class="button secondary demo-action" type="button" disabled
            >AUTHORIZE OAUTH CLIENT</button
          >
        </div>
      </section>
    </div>
  </section>

  <style>
    .demo-request-ledger {
      grid-column: 1 / -1;
      margin: 0;
      padding: 0 1.25rem 1.25rem;
    }
  </style>

  <script>
    import {
      authorizationRequest,
      canonicalScopeRequest,
      createPkce,
      DEVICE_CODE_GRANT_TYPE,
      demoProviderCapabilities,
      demoResourceFromIssuer,
      devicePollDecision,
      fetchDiscovery,
      inspectOAuthQuery,
      oauthDeviceTokenRequest,
      type ProviderCapability,
      verifyIdentityToken,
    } from "../../scripts/demo-protocol";

    const callbackUrl = new URL("/demo/callback", location.origin).href;
    const expectedRegistrationPath = "/api/auth/oauth2/register";
    const start = document.querySelector<HTMLButtonElement>("#browser-start")!;
    const status = document.querySelector<HTMLElement>("#browser-status")!;
    const deviceSessionStart = document.querySelector<HTMLButtonElement>("#device-session-start")!;
    const deviceOAuthStart = document.querySelector<HTMLButtonElement>("#device-oauth-start")!;
    const deviceStatus = document.querySelector<HTMLElement>("#device-status")!;
    const deviceInstructions = document.querySelector<HTMLElement>("#device-instructions")!;
    const providerSelect = document.querySelector<HTMLSelectElement>("#demo-provider")!;
    const scopeFieldset = document.querySelector<HTMLFieldSetElement>("#scope-fieldset")!;
    const scopeInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="demo-scope"]')];
    let discovery: Awaited<ReturnType<typeof fetchDiscovery>> | null = null;
    let resource = "";
    let working = false;
    let deviceWorking = false;
    let deviceCode = "";
    let deviceExpiresAt = 0;
    let deviceIntervalMs = 5_000;
    let devicePollTimer: number | undefined;
    let deviceController = new AbortController();
    let deviceMode: "oauth" | "session" = "session";
    let deviceClientId = "";
    let deviceTokenEndpoint = "";

    function message(text: string, tone: "working" | "error" | "success" = "working") {
      status.textContent = text;
      status.dataset.tone = tone;
    }

    function deviceMessage(
      text: string,
      tone: "working" | "error" | "success" = "working",
    ) {
      deviceStatus.textContent = text;
      deviceStatus.dataset.tone = tone;
    }

    function selectedCapability(): ProviderCapability | undefined {
      return demoProviderCapabilities.find((provider) => provider.id === providerSelect.value);
    }

    function selectedScopeRequest(provider: ProviderCapability): string {
      return canonicalScopeRequest(
        provider,
        scopeInputs.filter((input) => input.checked).map((input) => input.value),
      );
    }

    function updateRequestControls() {
      const provider = selectedCapability();
      const locked = working || deviceWorking;
      for (const input of scopeInputs) {
        const supported = provider?.scopes.some((scope) => scope === input.value) ?? false;
        input.disabled = locked || !supported;
        if (!supported) {
          input.checked = false;
        }
      }

      providerSelect.disabled = locked;
      scopeFieldset.disabled = locked;
      const providerName = provider?.id.toUpperCase() ?? "PROVIDER";
      start.textContent = discovery ? `SIGN IN WITH ${providerName}` : "LOADING AUTH SERVER";
      start.disabled = locked || !discovery || !provider;
      deviceSessionStart.disabled = locked || !discovery || !provider;
      deviceOAuthStart.disabled = locked || !discovery || !provider;
      document.querySelector<HTMLElement>("#demo-scope-request")!.textContent = provider
        ? selectedScopeRequest(provider)
        : "openid";
    }

    function clearPendingRequest() {
      sessionStorage.removeItem("triad_demo_client_id");
      sessionStorage.removeItem("triad_demo_resource");
      sessionStorage.removeItem("triad_demo_state");
      sessionStorage.removeItem("triad_demo_verifier");
    }

    function stopDevicePolling() {
      if (devicePollTimer !== undefined) {
        window.clearTimeout(devicePollTimer);
      }
      devicePollTimer = undefined;
    }

    function stopDeviceFlow() {
      stopDevicePolling();
      deviceController.abort();
    }

    function finishDeviceFlow() {
      deviceWorking = false;
      deviceSessionStart.textContent = "AUTHORIZE TRIAD SESSION";
      deviceOAuthStart.textContent = "AUTHORIZE OAUTH CLIENT";
      updateRequestControls();
    }

    function resetDevicePresentation() {
      deviceCode = "";
      deviceClientId = "";
      deviceExpiresAt = 0;
      deviceIntervalMs = 5_000;
      deviceTokenEndpoint = "";
      deviceInstructions.hidden = true;
      document.querySelector<HTMLElement>("#demo-user-code")!.textContent = "";
      document.querySelector<HTMLElement>("#device-client-id")!.textContent = "";
      document.querySelector<HTMLElement>("#device-expiry")!.textContent = "";
      document.querySelector<HTMLAnchorElement>("#verification-link")!.href = "/device/verify";
    }

    function scheduleDevicePoll() {
      const remaining = deviceExpiresAt - Date.now();
      if (remaining <= 0) {
        deviceMessage("This device code expired. Start a new device flow.", "error");
        stopDeviceFlow();
        finishDeviceFlow();
        return;
      }

      devicePollTimer = window.setTimeout(() => {
        void pollDevice();
      }, Math.min(deviceIntervalMs, remaining));
    }

    async function pollDevice() {
      if (!deviceWorking || !deviceCode) {
        return;
      }
      if (Date.now() >= deviceExpiresAt) {
        deviceMessage("This device code expired. Start a new device flow.", "error");
        stopDeviceFlow();
        finishDeviceFlow();
        return;
      }

      try {
        const isOAuthDevice = deviceMode === "oauth";
        const response = await fetch(deviceTokenEndpoint, {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": isOAuthDevice
              ? "application/x-www-form-urlencoded"
              : "application/json",
          },
          signal: deviceController.signal,
          body: isOAuthDevice
            ? oauthDeviceTokenRequest({
                clientId: deviceClientId,
                deviceCode,
                resource,
              })
            : JSON.stringify({
                grant_type: DEVICE_CODE_GRANT_TYPE,
                device_code: deviceCode,
                client_id: deviceClientId,
              }),
        });
        const body = (await response.json()) as {
          access_token?: string;
          error?: string;
          expires_in?: number;
          id_token?: string;
          token_type?: string;
        };
        if (!deviceWorking) {
          return;
        }
        if (
          response.ok &&
          body.access_token &&
          body.token_type === "Bearer" &&
          typeof body.expires_in === "number"
        ) {
          stopDevicePolling();
          if (isOAuthDevice) {
            if (!body.id_token) {
              throw new Error("The OAuth device response did not include an identity token.");
            }

            deviceMessage("OAuth tokens issued. Verifying the identity token.");
            await verifyIdentityToken(body.id_token, deviceClientId, location.origin, deviceController.signal);
            deviceMessage("OAuth device authorization complete. Identity token verified.", "success");
          } else {
            deviceMessage("Triad session authorization complete.", "success");
          }
          finishDeviceFlow();
          return;
        }

        const decision = devicePollDecision(body.error ?? "invalid_grant", deviceIntervalMs);
        deviceIntervalMs = decision.intervalMs;
        deviceMessage(decision.message, decision.continuePolling ? "working" : "error");
        if (decision.continuePolling) {
          scheduleDevicePoll();
          return;
        }

        stopDeviceFlow();
        finishDeviceFlow();
      } catch (reason) {
        if (reason instanceof DOMException && reason.name === "AbortError") {
          return;
        }

        deviceMessage("The device flow could not be completed. Start again.", "error");
        stopDeviceFlow();
        finishDeviceFlow();
      }
    }

    async function startDeviceFlow(mode: "oauth" | "session") {
      const provider = selectedCapability();
      if (working || deviceWorking || !discovery || !resource || !provider) {
        return;
      }

      stopDeviceFlow();
      resetDevicePresentation();
      deviceController = new AbortController();
      deviceMode = mode;
      deviceWorking = true;
      updateRequestControls();
      const activeStart = mode === "oauth" ? deviceOAuthStart : deviceSessionStart;
      activeStart.textContent = mode === "oauth" ? "REGISTERING CLIENT" : "REQUESTING CODE";
      deviceMessage(
        mode === "oauth"
          ? "Registering a public OAuth device client."
          : "Requesting a one-time Triad session code.",
      );

      try {
        const requestedScope = selectedScopeRequest(provider);
        deviceClientId =
          mode === "oauth"
            ? await registerDeviceClient(discovery, requestedScope)
            : location.origin;
        deviceTokenEndpoint =
          mode === "oauth" ? discovery.token_endpoint : "/api/auth/device/token";
        activeStart.textContent = "REQUESTING CODE";

        const request = new URLSearchParams({
          client_id: deviceClientId,
          scope: requestedScope,
        });
        if (mode === "oauth") {
          request.set("resource", resource);
        }

        const response = await fetch(discovery.device_authorization_endpoint, {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/x-www-form-urlencoded",
          },
          signal: deviceController.signal,
          body: request,
        });
        const body = (await response.json()) as {
          device_code?: string;
          error_description?: string;
          expires_in?: number;
          interval?: number;
          user_code?: string;
          verification_uri_complete?: string;
        };
        if (
          !response.ok ||
          !body.device_code ||
          !body.user_code ||
          !body.verification_uri_complete ||
          typeof body.expires_in !== "number" ||
          typeof body.interval !== "number"
        ) {
          throw new Error(body.error_description ?? "invalid device response");
        }

        deviceCode = body.device_code;
        deviceExpiresAt = Date.now() + body.expires_in * 1_000;
        deviceIntervalMs = Math.max(1, body.interval) * 1_000;
        document.querySelector<HTMLElement>("#demo-user-code")!.textContent = body.user_code;
        document.querySelector<HTMLElement>("#device-client-id")!.textContent =
          mode === "oauth" ? `REGISTERED CLIENT ${deviceClientId}` : "FIRST-PARTY TRIAD CLIENT";
        document.querySelector<HTMLAnchorElement>("#verification-link")!.href =
          body.verification_uri_complete;
        document.querySelector<HTMLElement>("#device-expiry")!.textContent =
          `Expires in ${Math.ceil(body.expires_in / 60)} minutes`;
        deviceInstructions.hidden = false;
        activeStart.textContent = "FLOW IN PROGRESS";
        deviceMessage("Waiting for browser approval.");
        scheduleDevicePoll();
      } catch (reason) {
        if (reason instanceof DOMException && reason.name === "AbortError") {
          return;
        }

        deviceMessage("A device code could not be issued. Check the broker and try again.", "error");
        stopDeviceFlow();
        finishDeviceFlow();
      }
    }

    async function loadMetadata() {
      start.disabled = true;
      start.textContent = "LOADING AUTH SERVER";
      message("Loading authorization server metadata.");

      try {
        discovery = await fetchDiscovery();
        if (new URL(discovery.registration_endpoint).pathname !== expectedRegistrationPath) {
          throw new Error("The authorization server advertised an unexpected registration endpoint.");
        }
        resource = demoResourceFromIssuer(discovery.issuer);
        document.querySelector<HTMLElement>("#demo-issuer")!.textContent = discovery.issuer;
        document.querySelector<HTMLElement>("#demo-resource")!.textContent = resource;
        updateRequestControls();
        message("Ready to register a one-time public client and create its PKCE request.", "success");
      } catch {
        discovery = null;
        resource = "";
        start.disabled = false;
        start.textContent = "RETRY METADATA";
        message("Authorization server metadata could not be loaded. Check the service and retry.", "error");
      }
    }

    async function registerBrowserClient(
      metadata: NonNullable<typeof discovery>,
      requestedScope: string,
    ): Promise<string> {
      const response = await fetch(metadata.registration_endpoint, {
        method: "POST",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({
          client_name: "Triad browser demo",
          redirect_uris: [callbackUrl],
          grant_types: ["authorization_code"],
          response_types: ["code"],
          token_endpoint_auth_method: "none",
          scope: requestedScope,
          application_type: "web",
        }),
      });
      const body = (await response.json()) as { client_id?: string; error_description?: string };
      if (!response.ok || !body.client_id) {
        throw new Error(body.error_description ?? "Public client registration failed.");
      }

      return body.client_id;
    }

    async function registerDeviceClient(
      metadata: NonNullable<typeof discovery>,
      requestedScope: string,
    ): Promise<string> {
      const response = await fetch(metadata.registration_endpoint, {
        method: "POST",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({
          client_name: "Triad OAuth device demo",
          application_type: "native",
          grant_types: [DEVICE_CODE_GRANT_TYPE],
          token_endpoint_auth_method: "none",
          scope: requestedScope,
        }),
      });
      const body = (await response.json()) as { client_id?: string; error_description?: string };
      if (!response.ok || !body.client_id) {
        throw new Error(body.error_description ?? "OAuth device client registration failed.");
      }

      return body.client_id;
    }

    async function startProvider(provider: ProviderCapability, authorization: URL): Promise<void> {
      const authorizationResponse = await fetch(authorization, {
        headers: { accept: "application/json" },
      });
      const authorizationBody = (await authorizationResponse.json()) as {
        error_description?: string;
        url?: string;
      };
      if (!authorizationResponse.ok || !authorizationBody.url) {
        throw new Error(authorizationBody.error_description ?? "Authorization could not start.");
      }

      const signedAuthorization = new URL(authorizationBody.url, location.origin);
      const inspected = inspectOAuthQuery(signedAuthorization.search);
      if (
        signedAuthorization.origin !== location.origin ||
        inspected.clientId !== authorization.searchParams.get("client_id")
      ) {
        throw new Error("The authorization server returned an invalid login request.");
      }

      if (provider.id === "ethereum" || provider.id === "passkey") {
        const signOutResponse = await fetch("/api/auth/sign-out", {
          method: "POST",
          headers: { accept: "application/json", "content-type": "application/json" },
          body: "{}",
        });
        if (!signOutResponse.ok) {
          throw new Error("The existing authorization session could not be cleared.");
        }

        signedAuthorization.hash = new URLSearchParams({ provider: provider.id }).toString();
        location.assign(signedAuthorization);
        return;
      }

      const response = await fetch("/api/auth/sign-in/social", {
        method: "POST",
        headers: {
          accept: "application/json",
          "content-type": "application/json",
        },
        body: JSON.stringify({
          provider: provider.id,
          oauth_query: signedAuthorization.search.slice(1),
        }),
      });
      const body = (await response.json()) as {
        error_description?: string;
        message?: string;
        url?: string;
      };
      if (!response.ok || !body.url) {
        throw new Error(body.error_description ?? body.message ?? "Provider sign-in could not start.");
      }

      location.assign(body.url);
    }

    async function startBrowserFlow() {
      if (working || deviceWorking) {
        return;
      }
      if (!discovery || !resource) {
        await loadMetadata();
        return;
      }

      const selectedProvider = selectedCapability();
      if (!selectedProvider) {
        return;
      }
      const requestedScope = selectedScopeRequest(selectedProvider);

      working = true;
      updateRequestControls();
      start.textContent = "PREPARING PKCE";
      message("Registering a public client and creating a one-time S256 request.");
      clearPendingRequest();

      try {
        const [clientId, pkce] = await Promise.all([
          registerBrowserClient(discovery, requestedScope),
          createPkce(),
        ]);
        document.querySelector<HTMLElement>("#demo-client-id")!.textContent = clientId;
        sessionStorage.setItem("triad_demo_client_id", clientId);
        sessionStorage.setItem("triad_demo_resource", resource);
        sessionStorage.setItem("triad_demo_state", pkce.state);
        sessionStorage.setItem("triad_demo_verifier", pkce.verifier);

        const authorization = authorizationRequest({
          authorizationEndpoint: discovery.authorization_endpoint,
          callbackUrl,
          challenge: pkce.challenge,
          clientId,
          resource,
          scope: requestedScope,
          state: pkce.state,
        });
        await startProvider(selectedProvider, authorization);
      } catch {
        clearPendingRequest();
        working = false;
        updateRequestControls();
        start.textContent = "RETRY BROWSER FLOW";
        message("The public client, PKCE request, or provider sign-in could not start. Try again.", "error");
      }
    }

    for (const provider of demoProviderCapabilities) {
      const option = document.createElement("option");
      option.value = provider.id;
      option.textContent = provider.id.toUpperCase();
      providerSelect.append(option);
    }
    providerSelect.disabled = false;
    scopeFieldset.disabled = false;
    providerSelect.addEventListener("change", updateRequestControls);
    scopeInputs.forEach((input) => input.addEventListener("change", updateRequestControls));
    start.addEventListener("click", () => {
      void startBrowserFlow();
    });
    deviceSessionStart.addEventListener("click", () => {
      void startDeviceFlow("session");
    });
    deviceOAuthStart.addEventListener("click", () => {
      void startDeviceFlow("oauth");
    });
    window.addEventListener("pagehide", stopDeviceFlow);
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) {
        return;
      }

      stopDeviceFlow();
      working = false;
      deviceWorking = false;
      deviceController = new AbortController();
      clearPendingRequest();
      resetDevicePresentation();
      deviceSessionStart.textContent = "AUTHORIZE TRIAD SESSION";
      deviceOAuthStart.textContent = "AUTHORIZE OAUTH CLIENT";
      updateRequestControls();
      message("This page was restored from browser history. Start a new request.");
      deviceMessage("No device request is active.");
    });
    updateRequestControls();
    void loadMetadata();
  </script>
</Shell>
