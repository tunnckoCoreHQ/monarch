{
  "tunnckoCoreHQ/monarch": {
    "snapshot": "monarch-master",
    "workdir": "/home/boxd/work/monarch",
    "on": {
      "push": ["master"],
      "pull_request": true
    },
    "setup": [
      "git diff --quiet \"$BASE\" HEAD -- pnpm-lock.yaml pnpm-workspace.yaml .npmrc patches || pnpm install --frozen-lockfile --ignore-scripts"
    ],
    "jobs": {
      "check": "pnpm exec turbo run check $AFFECTED",
      "test": "pnpm exec turbo run test --filter='!./solidity/*' $AFFECTED",
      "test-solidity": "pnpm exec turbo run test --filter='./solidity/*'",
      "build": "pnpm exec turbo run build --filter='./packages/*' --filter='./solidity/*' $AFFECTED"
    },
    "promote": "master",
    "cold": "0 3 * * *"
  }
}
