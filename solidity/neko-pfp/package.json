{
  "name": "neko-pfp",
  "version": "0.0.0",
  "private": true,
  "description": "Fully on-chain, pixel-perfect generative 0xNeko SVG art with committed reveal and a burn-based fusion game",
  "license": "GPL-3.0-or-later",
  "author": "tunnckoCore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCore/triad-auth.git",
    "directory": "solidity/neko-pfp"
  },
  "type": "module",
  "scripts": {
    "build": "forge build",
    "check": "vp run fmt && vp run lint && vp run test && vp run build && vp run check:extra",
    "check:extra": "echo nothing-yet",
    "fmt": "forge fmt",
    "gas": "forge snapshot --no-match-test testFuzz",
    "lint": "forge lint --deny warnings",
    "snapshot": "if [ -f .gas-snapshot ]; then exec forge snapshot --check --no-match-test testFuzz; else exec vp run gas; fi",
    "test": "forge test"
  },
  "dependencies": {
    "erc721a": "catalog:",
    "solady": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:types",
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "typescript": "catalog:types",
    "viem": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
