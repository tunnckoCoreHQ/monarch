{
  "name": "subdrop",
  "version": "0.0.0",
  "private": true,
  "description": "ENS subname mint-to-earn: mint a subname and receive the parent's project token in one transaction",
  "license": "Apache-2.0",
  "author": "tunnckoCore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCoreHQ/monarch.git",
    "directory": "solidity/subdrop"
  },
  "scripts": {
    "build": "forge build",
    "check": "vp run fmt && vp run lint && vp run test && vp run build",
    "fmt": "forge fmt",
    "gas": "forge snapshot --no-match-test testFuzz",
    "lint": "forge lint --deny warnings",
    "snapshot": "if [ -f .gas-snapshot ]; then exec forge snapshot --check --no-match-test testFuzz; else exec vp run gas; fi",
    "test": "forge test"
  },
  "dependencies": {
    "solady": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:types",
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "typescript": "catalog:types",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
